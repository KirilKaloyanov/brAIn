# Copy to .env and fill in. Never commit .env.

# development | test | production
NODE_ENV=development

# Port the backend listens on (Cloud Run sets PORT itself, default 8080)
PORT=8080

# App origin, no path; used for the OAuth redirect URL and the Origin check.
# In development the browser talks to Vite (npm run dev:web), so this is its origin.
PUBLIC_URL=http://localhost:5173

# Google Cloud project for Firestore; demo-brain matches the local emulator
GOOGLE_CLOUD_PROJECT=demo-brain

# Firestore emulator started with `npm run emulator`; development only, never in production
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081

# The owner's Google account: the only one allowed to sign in
ALLOWED_EMAIL=you@example.com

# OAuth client for Google sign-in (setup in docs/development.md)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
